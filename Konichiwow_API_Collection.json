{
  "info": {
    "name": "Konichiwow API Collection",
    "_postman_id": "fbc1d950-7b5c-41a3-bb3f-7a932c3a9d89",
    "description": "Postman collection for Konichiwow Backend (Firebase Functions + MongoDB). Contains all endpoints for Authentication, Expenses, and Reports APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Devdatta Wagh\",\n  \"email\": \"devtest@example.com\",\n  \"password\": \"test12345\"\n}"
            },
            "url": { "raw": "{{base_url}}/register", "host": ["{{base_url}}"], "path": ["register"] },
            "description": "Registers a new user in the Konichiwow app."
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"devtest@example.com\",\n  \"password\": \"test12345\"\n}"
            },
            "url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] },
            "description": "Logs in a user and returns an ID token."
          }
        },
        {
          "name": "Logout User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/logout", "host": ["{{base_url}}"], "path": ["logout"] },
            "description": "Logs out a user (client-side token removal)."
          }
        }
      ]
    },
    {
      "name": "Expenses",
      "item": [
        {
          "name": "Add Expense",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{idToken}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Lunch\",\n  \"amount\": 250,\n  \"category\": \"Food\",\n  \"date\": \"2025-11-01\"\n}"
            },
            "url": { "raw": "{{base_url}}/expenses", "host": ["{{base_url}}"], "path": ["expenses"] },
            "description": "Creates a new expense record."
          }
        },
        {
          "name": "Get All Expenses",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{idToken}}", "type": "text" }],
            "url": { "raw": "{{base_url}}/expenses", "host": ["{{base_url}}"], "path": ["expenses"] },
            "description": "Retrieves all expenses for the authenticated user."
          }
        },
        {
          "name": "Get Expense by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{idToken}}", "type": "text" }],
            "url": { "raw": "{{base_url}}/expenses/:id", "host": ["{{base_url}}"], "path": ["expenses", ":id"] },
            "description": "Retrieves a specific expense by its ID."
          }
        },
        {
          "name": "Update Expense",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{idToken}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Lunch\",\n  \"amount\": 300\n}"
            },
            "url": { "raw": "{{base_url}}/expenses/:id", "host": ["{{base_url}}"], "path": ["expenses", ":id"] },
            "description": "Updates an existing expense."
          }
        },
        {
          "name": "Delete Expense",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{idToken}}", "type": "text" }],
            "url": { "raw": "{{base_url}}/expenses/:id", "host": ["{{base_url}}"], "path": ["expenses", ":id"] },
            "description": "Deletes an expense by ID."
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Get Monthly Report",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{idToken}}", "type": "text" }],
            "url": {
              "raw": "{{base_url}}/reports/monthly?month=11&year=2025",
              "host": ["{{base_url}}"],
              "path": ["reports", "monthly"],
              "query": [
                { "key": "month", "value": "11" },
                { "key": "year", "value": "2025" }
              ]
            },
            "description": "Fetches a monthly expense report for a given month and year."
          }
        },
        {
          "name": "Get Category Report",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{idToken}}", "type": "text" }],
            "url": {
              "raw": "{{base_url}}/reports/category?category=Food",
              "host": ["{{base_url}}"],
              "path": ["reports", "category"],
              "query": [{ "key": "category", "value": "Food" }]
            },
            "description": "Fetches expense summary for a specific category."
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://us-central1-konichiwow-backend.cloudfunctions.net/api"
    },
    {
      "key": "idToken",
      "value": ""
    }
  ]
}
